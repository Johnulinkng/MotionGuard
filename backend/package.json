{
  "name": "motion-guard-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.ts",
    "check": "npm run generate && npm run typecheck && npm test",
    "contract:check": "node scripts/contract-check.mjs",
    "preflight": "node --env-file-if-exists=.env --import tsx scripts/preflight.ts",
    "smoke:local": "node --env-file-if-exists=.env scripts/local-smoke.mjs",
    "verify:real": "node --env-file-if-exists=.env scripts/verify-real-result.mjs"
  },
  "dependencies": {
    "@langchain/langgraph": "1.5.2",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "viem": "2.57.4",
    "zod": "4.6.6",
    "undici": "6.29.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
