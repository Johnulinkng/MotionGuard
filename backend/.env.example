# Local API remains MOCK until testnet configuration and real integration pass.
MOTION_PORT=4011
MOTION_HOST=127.0.0.1
MOTION_DB_PATH=data/private/motion.sqlite
MOTION_EXECUTION_MODE=MOCK
# Normal mode uses real public sources and requires a real model configuration.
MOTION_RESOURCE_MODE=live
MOTION_LLM_MODE=real
MOTION_ENABLE_DEMO_SCENARIOS=0
# Set a private operator token for authenticated local access. Never commit .env.
MOTION_OPERATOR_TOKEN=
MOTION_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DeepSeek key is loaded only by backend. Model usage may incur provider charges.
MOTION_LLM_BASE_URL=https://api.deepseek.com
MOTION_LLM_API_KEY=
MOTION_LLM_MODEL=deepseek-flash
# TESTNET configuration; do not paste private keys into chat or frontend.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Later testnet payer reads a dedicated test key file in the signer child only.
MOTION_SIGNER_KEY_FILE=
MOTION_TESTNET_ROUTES_FILE=
