# Public API origin. Empty uses the Vite same-origin /api proxy.
VITE_API_BASE=
# Explicit contract simulator controls. MOCK backend responses do not imply support.
# npm run dev:mock enables this for its own Vite child; keep false for backend use.
VITE_SIMULATOR_CONTROLS=false
# Development proxy destination; no credentials belong here.
MOTION_API_TARGET=http://127.0.0.1:4011
